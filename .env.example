SUPABASE_DB_PASSWORD=         # migrations and the SQL audit
DEMO_ACCOUNTS_PASSWORD=       # shared password for the seeded demo accounts, nobody signs into them

# Read by scripts/verify-security.mjs. Credentials, so they live here and nowhere else (AC5).
