# The only two that reach Vercel. Both begin with NEXT_PUBLIC_ by design (TDD 5).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local only. Never in Vercel, never committed.
